  "addons": {
    "intake": {
      "insertAfter": "surveyBodyStart",
      "timing": "pre",
      "questions": [
        { "type": "sectionHeader", "label": "Background" },
        {
          "type": "sectionDescription",
          "html": "These questions are asked once and won't appear on your return visits.<br><span style=\"color:#888\">All items are optional — skip anything you'd rather not answer.</span>"
        },

        {
          "type": "singleSelect",
          "field": "ericaMHRole",
          "blockId": "ericaMHRoleBlock",
          "skipIfReturning": true,
          "required": false,
          "conditionalTarget": "ericaMHRoleDetail",
          "question": "Do you work in mental or behavioral health?",
          "options": [
            { "value": "yes", "label": "Yes" },
            { "value": "no",  "label": "No" }
          ]
        },

        {
          "type": "conditional",
          "id": "ericaMHRoleDetail",
          "questions": [
            {
              "type": "multiSelect",
              "field": "ericaMHRoleTypes",
              "required": false,
              "question": "What is your role? (Select all that apply)",
              "exclusiveValue": "prefer_not",
              "options": [
                { "value": "psychiatrist",                "label": "Psychiatrist" },
                { "value": "psychologist",                "label": "Psychologist" },
                { "value": "neuropsychologist",           "label": "Neuropsychologist" },
                { "value": "therapist_counselor",         "label": "Therapist / Counselor" },
                { "value": "training_therapist",          "label": "Training Therapist" },
                { "value": "social_worker",               "label": "Social Worker" },
                { "value": "student",                     "label": "Student" },
                { "value": "peer_counselor",              "label": "Peer Counselor" },
                { "value": "personal_coach",              "label": "Personal Coach" },
                { "value": "executive_coach",             "label": "Executive Coach" },
                { "value": "crisis_counselor",            "label": "Crisis Counselor" },
                { "value": "crisis_intervention",         "label": "Crisis Intervention Specialist" },
                { "value": "psych_np",                    "label": "Psychiatric Nurse Practitioner" },
                { "value": "outreach_worker",             "label": "Outreach Worker" },
                { "value": "recovery_coach",              "label": "Recovery Coach" },
                { "value": "intake_coordinator",          "label": "Intake Coordinator" },
                { "value": "rehab_iop_therapist",         "label": "Rehab / Inpatient / IOP Therapist" },
                { "value": "rehab_iop_worker",            "label": "Rehab / Inpatient / IOP Worker" },
                { "value": "education_specialist",        "label": "Education Specialist / Consultant" },
                { "value": "school_counselor",            "label": "School-Based Counselor / Psychologist" },
                { "value": "case_manager",                "label": "Case Manager" },
                { "value": "care_coordinator",            "label": "Care Coordinator" },
                { "value": "program_director",            "label": "Program Director / Manager / Coordinator" },
                { "value": "mh_administrator",            "label": "Mental Health Administrator" },
                { "value": "bh_administrator",            "label": "Behavioral Health Administrator" },
                { "value": "other",                       "label": "Other" },
                { "value": "prefer_not",                  "label": "Prefer not to say" }
              ]
