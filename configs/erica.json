        {
          "type": "multiSelect",
          "field": "ericaMeds",
          "blockId": "ericaMedsBlock",
          "skipIfReturning": true,
          "required": false,
          "question": "Are you currently taking any of the following medications?",
          "hint": "Select all that apply. This is optional.",
          "exclusiveValues": ["none", "prefer_not"],
          "options": [
            { "value": "stimulants",       "label": "Stimulants" },
            { "value": "antidepressants",  "label": "Antidepressants" },
            { "value": "mood_stabilizers", "label": "Mood Stabilizers" },
            { "value": "anxiolytics",      "label": "Anti-Anxiety Medication / Sedatives" },
            { "value": "sleep_meds",       "label": "Sleep Medications" },
            { "value": "hrt",              "label": "Hormone Replacement Therapy (HRT)" },
            { "value": "other",            "label": "Other" },
            { "value": "none",             "label": "None" },
            { "value": "prefer_not",       "label": "Prefer not to say" }
