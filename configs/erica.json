            { "value": "fibromyalgia",        "label": "Fibromyalgia" },
            { "value": "autoimmune",          "label": "Autoimmune Issues" },
            { "value": "migraines",           "label": "Migraines" },
            { "value": "insomnia",            "label": "Insomnia" },
            { "value": "sleep_apnea",         "label": "Sleep Apnea" },
            { "value": "depression",          "label": "Depression" },
            { "value": "bipolar",             "label": "Bipolar Disorder / Mania" },
            { "value": "emotional_dysreg",    "label": "Emotional Dysregulation" },
            { "value": "suicidality",         "label": "Suicidality" },
            { "value": "self_harm",           "label": "Self-Harming Behaviors" },
            { "value": "eating_disorder",     "label": "Eating Disorder" },
            { "value": "gender_dysphoria",    "label": "Gender Dysphoria" },
            { "value": "addiction",           "label": "Addiction" },
            { "value": "substance_use",       "label": "Substance Use Issues / Dependence" },
            { "value": "physical_disability", "label": "Physical Disability" },
            { "value": "post_injury_psych",   "label": "Emotional / Psychological Issues Secondary to Physical Injury" },
            { "value": "other",               "label": "Other" },
            { "value": "none",                "label": "None of these" },
            { "value": "prefer_not",          "label": "Prefer not to say" }
          ]
