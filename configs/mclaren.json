{
  "preset": {
    "displayName": "McLaren Racing",
    "addons": [
      "mclarenPreSection",
      "mclarenSoreness",
      "mclarenPerfReadiness",
      "mclarenPost"
    ]
  },
  "addons": {
    "mclarenPreSection": {
      "insertAfter": "surveyBodyStart",
      "timing": "pre",
      "required": {
        "pre": [
          "mclRole",
          "mclUsageCount",
          "mclPrimaryReason",
          "mclPromptedBy"
        ]
      },
      "questions": [
        {
          "type": "sectionHeader",
          "label": "Role &amp; Usage"
        },
        {
          "type": "singleSelect",
          "field": "mclRole",
          "question": "What is your role?",
          "options": [
            {
              "value": "driver",
              "label": "Driver"
            },
            {
              "value": "engineer",
              "label": "Engineer"
            },
            {
              "value": "mechanic",
              "label": "Mechanic"
            },
            {
              "value": "strategist",
              "label": "Strategist"
            },
            {
              "value": "management",
              "label": "Team Management"
            },
            {
              "value": "physio",
              "label": "Physiotherapist / Trainer"
            },
            {
              "value": "other",
              "label": "Other"
            }
          ]
        },
        {
          "type": "singleSelect",
          "field": "mclUsageCount",
          "question": "How many times have you used the Shiftwave chair before today?",
          "conditionalTarget": "mclConditional",
          "options": [
            {
              "value": "first_time",
              "label": "This is my first time"
            },
            {
              "value": "1_2",
              "label": "1–2 times"
            },
            {
              "value": "3_5",
              "label": "3–5 times"
            },
            {
              "value": "6_10",
              "label": "6–10 times"
            },
            {
              "value": "10plus",
              "label": "More than 10 times"
            }
          ]
        },
        {
          "type": "singleSelect",
          "field": "mclPrimaryReason",
          "question": "What is your PRIMARY reason for using Shiftwave today?",
          "options": [
            {
              "value": "recovery",
              "label": "Recovery after physical work or exertion"
            },
            {
              "value": "mental_reset",
              "label": "Mental reset and focus"
            },
            {
              "value": "pre_perf",
              "label": "Pre-performance preparation"
            },
            {
              "value": "stress",
              "label": "To manage stress or tension"
            },
            {
              "value": "relax",
              "label": "To relax / unwind after a long day"
            },
            {
              "value": "physical",
              "label": "To relieve physical tension or soreness"
            },
            {
              "value": "curiosity",
              "label": "Curiosity / trying it out"
            },
            {
              "value": "other",
              "label": "Other"
            }
          ]
        },
        {
          "type": "singleSelect",
          "field": "mclPromptedBy",
          "question": "What prompted you to use Shiftwave TODAY?",
          "options": [
            {
              "value": "stressed",
              "label": "Feeling stressed or fatigued"
            },
            {
              "value": "preventative",
              "label": "Preventative / regular recovery routine"
            },
            {
              "value": "physical",
              "label": "Physical soreness or discomfort"
            },
            {
              "value": "focus",
              "label": "Trouble focusing or mentally preparing"
            },
            {
              "value": "downtime",
              "label": "Scheduled downtime"
            },
            {
              "value": "available",
              "label": "Saw the chair was available"
            },
            {
              "value": "recommended",
              "label": "Recommended by someone"
            },
            {
              "value": "other",
              "label": "Other"
            }
          ]
        },
        {
          "type": "conditional",
          "id": "mclConditional",
          "questions": [
            {
              "type": "multiSelect",
              "field": "mclTiming",
              "question": "When do you typically use Shiftwave?",
              "hint": "Select all that apply",
              "exclusiveValue": "no_pattern",
              "options": [
                {
                  "value": "before",
                  "label": "Before work / sessions begin"
                },
                {
                  "value": "during",
                  "label": "During breaks between tasks"
                },
                {
                  "value": "after",
                  "label": "After work / sessions (wind down)"
                },
                {
                  "value": "when_stressed",
                  "label": "When I’m feeling stressed or fatigued"
                },
                {
                  "value": "routine",
                  "label": "As part of a regular routine"
                },
                {
                  "value": "no_pattern",
                  "label": "No regular pattern"
                },
                {
                  "value": "other",
                  "label": "Other"
                }
              ]
            },
            {
              "type": "multiSelect",
              "field": "mclKeepsComing",
              "question": "What keeps you coming back to Shiftwave?",
              "options": [
                {
                  "value": "effective",
                  "label": "It’s effective at reducing my stress / tension"
                },
                {
                  "value": "convenient",
                  "label": "It’s quick and convenient"
                },
                {
                  "value": "fits",
                  "label": "It fits into my routine easily"
                },
                {
                  "value": "physical",
                  "label": "I enjoy the physical sensation"
                },
                {
                  "value": "refocus",
                  "label": "It helps me refocus and mentally reset"
                },
                {
                  "value": "better",
                  "label": "It’s better than other recovery tools I’ve tried"
                },
                {
                  "value": "routine",
                  "label": "It’s become part of my performance / recovery routine"
                },
                {
                  "value": "other",
                  "label": "Other"
                }
              ]
            }
          ]
        }
      ]
    },
    "mclarenSoreness": {
      "insertAfter": "vasItem_bodyConnection",
      "timing": "both",
      "questions": [
        {
          "type": "vas",
          "field": "addonMclSoreness",
          "question": "How sore does your body feel right now?",
          "labelLow": "Not Sore",
          "labelHigh": "Extremely Sore"
        }
      ]
    },
    "mclarenPerfReadiness": {
      "insertAfter": "vasItem_alertness",
      "timing": "both",
      "questions": [
        {
          "type": "vas",
          "field": "addonMclPerfReadiness",
          "question": "How ready do you feel to perform your job right now?",
          "labelLow": "Not Ready",
          "labelHigh": "Fully Ready"
        }
      ]
    },
    "mclarenPost": {
      "insertAfter": "emojiGridSection",
      "timing": "post",
      "required": {
        "post": [
          "mclAccept1",
          "mclAccept2",
          "mclAccept3",
          "mclAccept4",
          "mclAccept5",
          "mclAccept6",
          "mclUseAgain",
          "mclRecommend",
          "mclFrequency",
          "mclWouldHelp",
          "mclComparison"
        ]
      },
      "questions": [
        {
          "type": "sectionHeader",
          "label": "Your Experience"
        },
        {
          "type": "sectionDescription",
          "html": "Rate each statement about this session.<br><span style=\"font-size:0.8em;color:#888;\">(1 = Strongly disagree &mdash; 5 = Strongly agree)</span>"
        },
        {
          "type": "likert5",
          "field": "mclAccept1",
          "question": "I enjoyed this session"
        },
        {
          "type": "likert5",
          "field": "mclAccept2",
          "question": "The session fit conveniently into my schedule"
        },
        {
          "type": "likert5",
          "field": "mclAccept3",
          "question": "I understand how Shiftwave is supposed to help"
        },
        {
          "type": "likert5",
          "field": "mclAccept4",
          "question": "This session helped me feel calmer and more relaxed"
        },
        {
          "type": "likert5",
          "field": "mclAccept5",
          "question": "The vibration sensation was comfortable"
        },
        {
          "type": "likert5",
          "field": "mclAccept6",
          "question": "I would use Shiftwave as part of my recovery and performance routine"
        },
        {
          "type": "sectionHeader",
          "label": "Performance &amp; Recovery",
          "style": "margin-top:24px;"
        },
        {
          "type": "nps",
          "field": "mclUseAgain",
          "question": "How likely are you to use Shiftwave again?",
          "labelLow": "Not at all likely",
          "labelHigh": "Extremely likely"
        },
        {
          "type": "nps",
          "field": "mclRecommend",
          "question": "How likely are you to recommend Shiftwave to teammates or colleagues?",
          "labelLow": "Not at all likely",
          "labelHigh": "Extremely likely"
        },
        {
          "type": "singleSelect",
          "field": "mclFrequency",
          "question": "How often do you see yourself using Shiftwave?",
          "options": [
            {
              "value": "daily",
              "label": "Daily"
            },
            {
              "value": "few_week",
              "label": "A few times a week"
            },
            {
              "value": "weekly",
              "label": "Weekly"
            },
            {
              "value": "race_weekends",
              "label": "Race weekends only"
            },
            {
              "value": "few_month",
              "label": "A few times a month"
            },
            {
              "value": "rarely",
              "label": "Rarely"
            }
          ]
        },
        {
          "type": "singleSelect",
          "field": "mclWouldHelp",
          "question": "Would having Shiftwave available help improve your work or performance?",
          "options": [
            {
              "value": "def_not",
              "label": "Definitely not"
            },
            {
              "value": "prob_not",
              "label": "Probably not"
            },
            {
              "value": "not_sure",
              "label": "Not sure"
            },
            {
              "value": "prob_yes",
              "label": "Probably yes"
            },
            {
              "value": "def_yes",
              "label": "Definitely yes"
            }
          ]
        },
        {
          "type": "singleSelect",
          "field": "mclComparison",
          "question": "How does Shiftwave compare to other recovery or mental preparation tools you use?",
          "options": [
            {
              "value": "much_better",
              "label": "Much better"
            },
            {
              "value": "somewhat_better",
              "label": "Somewhat better"
            },
            {
              "value": "same",
              "label": "About the same"
            },
            {
              "value": "somewhat_worse",
              "label": "Somewhat worse"
            },
            {
              "value": "much_worse",
              "label": "Much worse"
            },
            {
              "value": "no_other_tools",
              "label": "I don’t use other tools"
            }
          ]
        }
      ]
    }
  }
}
