{
  "preset": {
    "displayName": "Burnout Study",
    "studyTag": "suzanne_burnout_2026",
    "anonymousMode": false,
    "suppressFemaleHealthBlock": false,
    "defaultProtocol": "Cognitive Clarity Reset",
    "addons": ["szEmotionalState", "szTension", "szAcceptPost"]
  },

  "_notes": {
    "tension_scale": "Tension and emotional state items use Suzanne's 4-point Likert scale (1=Not At All, 4=Very Much So) to maintain commensurability with her paper instrument and Huddersfield data. To switch to VAS, replace singleSelect blocks with vas type and remove options arrays.",
    "3day_followup": "3-day follow-up timing is not yet implemented in the SFI HTML. Acceptability item (sz_use_again) has been added to post as the closest available substitute. When 3-day timing is built, move sz_use_again and the open-ended experience question there.",
    "pii": "Suzanne's form captures email, phone, and date. These require edge function changes to route to participant_keys only. Not implemented here — coordinate with Wyatt.",
    "open_ended": "Suzanne uses different open-ended prompts at each timepoint. Pre: life/work context. Post: experience of the chair. The core SFI comment field is currently a fixed placeholder — per-deployment/per-timing comment text requires a small HTML change.",
    "overlap_items": "Most emotional state items overlap with SSS (energetic, anxious, tired, foggy, calm, clear, tense). They are included here in full to preserve commensurability with her paper form. Genuinely novel items: sz_es_worn_out, sz_es_managing_emotions, sz_es_burnout_capacity."
  },

  "addons": {

    "szEmotionalState": {
