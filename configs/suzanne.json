          "type": "sectionDescription",
          "html": "Read each statement and indicate how you feel <strong>right now</strong>."
        },
        {
          "type": "singleSelect",
          "field": "sz_es_worn_out",
          "question": "I feel worn out and weary",
          "options": [
            { "value": "1", "label": "Not At All" },
            { "value": "2", "label": "Somewhat" },
            { "value": "3", "label": "Moderately So" },
            { "value": "4", "label": "Very Much So" }
          ]
        },
        {
          "type": "singleSelect",
          "field": "sz_es_energetic",
          "question": "I feel energetic",
          "options": [
            { "value": "1", "label": "Not At All" },
            { "value": "2", "label": "Somewhat" },
            { "value": "3", "label": "Moderately So" },
            { "value": "4", "label": "Very Much So" }
